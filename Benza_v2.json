        "messages": {
          "values": [
            {
              "content": "=You are an expert HR resume evaluator for Benza company.\n\nEvaluate the following candidate resume against the job description and score each criteria strictly.\n\nJob Description:\nWe are looking for a skilled developer with the following requirements:\n- Strong programming skills in Python, SQL or relevant technologies\n- Minimum 1+ years of work experience (freshers with strong projects will be considered)\n- Demonstrated projects showing real world problem solving\n- Relevant educational background in Computer Science or related field\n\nCandidate Details:\nSkills: {{ $json.skills }}\nYears of Experience: {{ $json.years_of_experience }}\nExperience: {{ $json.experience_description }}\nProjects: {{ $json.projects }}\nEducation: {{ $json.education }}\n\nScore each criteria and respond in ONLY this exact format, nothing else:\n\nskills_score: <0-40>\nexperience_score: <0-30>\nprojects_score: <0-20>\neducation_score: <0-10>\ntotal_score: <0-100>\ndecision: <Strong/Average/Weak>\nreason: <one sentence explanation>"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 300,
          "thinkingBudget": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1056,
        0
      ],
      "id": "4048408c-2ec3-4c83-8c97-741191e8a6b4",
      "name": "Gemini Scorer",
      "credentials": {
        "googlePalmApi": {
          "id": "j5fq4zhur0q1QhNI",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content.parts[0].text;\n\n// Clean JSON from markdown code blocks\nconst clean = text.replace(/```json|```/g, '').trim();\nconst extracted = JSON.parse(clean);\n\nreturn {\n  json: {\n    skills: Array.isArray(extracted.skills) ? extracted.skills.join(', ') : extracted.skills,\n    years_of_experience: extracted.years_of_experience,\n    experience_description: extracted.experience_description,\n    projects: extracted.projects,\n    education: extracted.education\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        0
      ],
      "id": "2b471fef-f4fd-41c3-b10e-9410c15ca7c9",
      "name": "Parse Extractor"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content.parts[0].text;\n\nconst lines = text.split('\\n');\nconst getValue = (key) => {\n  const line = lines.find(l => l.startsWith(key));\n  return line ? line.split(':')[1].trim() : '0';\n};\n\nreturn {\n  json: {\n    name: $('Parse Extractor').item.json.name,\n    email: $('Parse Extractor').item.json.email,\n    skills: $('Parse Extractor').item.json.skills,\n    years_of_experience: $('Parse Extractor').item.json.years_of_experience,\n    experience_description: $('Parse Extractor').item.json.experience_description,\n    projects: $('Parse Extractor').item.json.projects,\n    education: $('Parse Extractor').item.json.education,\n    skills_score: getValue('skills_score'),\n    experience_score: getValue('experience_score'),\n    projects_score: getValue('projects_score'),\n    education_score: getValue('education_score'),\n    total_score: getValue('total_score'),\n    decision: getValue('decision'),\n    reason: getValue('reason'),\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        0
      ],
      "id": "842b5167-4604-4c3a-a950-9dd4cd491814",
      "name": "Parse Scorer"
    },
