        "messages": {
          "values": [
            {
              "content": "You are a strict resume parser. Extract information from the resume text below.\n\nRules:\n- Extract ONLY what is explicitly written in the resume\n- If information is not clearly stated, mark it as \"CND\" (Cannot be Determined)\n- For skills, extract ALL technical tools, technologies and programming languages mentioned\n- For years_of_experience, calculate total years from all work experience combined\n- For experience_description, summarize all job roles and responsibilities\n- For projects, summarize all projects mentioned under KEY PROJECTS section\n- For education, extract degree name and institution\n\nRespond in ONLY this exact JSON format, nothing else, no markdown, no code blocks:\n\n{\n  \"skills\": [\"skill1\", \"skill2\"],\n  \"years_of_experience\": \"total years as a number\",\n  \"experience_description\": \"summary of all work experience\",\n  \"projects\": \"summary of all projects\",\n  \"education\": \"degree and institution\"\n}\n\nResume Text:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 500,
          "thinkingBudget": 0
        }
      },
