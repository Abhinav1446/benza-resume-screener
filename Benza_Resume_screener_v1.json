        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an expert HR resume evaluator for Benza company.\n\nEvaluate the following candidate resume against the job description and score each criteria strictly.\n\nJob Description:\nWe are looking for a skilled developer with the following requirements:\n- Strong programming skills in Python, SQL or relevant technologies\n- Minimum 1+ years of work experience (freshers with strong projects will be considered)\n- Demonstrated projects showing real world problem solving\n- Relevant educational background in Computer Science or related field\n\nCandidate Details:\nName: {{ $('Google Sheets Trigger').item.json['Full Name'] }}\nJob Role Applying For: {{ $('Google Sheets Trigger').item.json['Job Applying for (Python Developer or Data Analyst)'] }}\nSkills: {{ $('Google Sheets Trigger').item.json['Your skills (eg: Python, SQL, Power BI)'] }}\nExperience: {{ $('Google Sheets Trigger').item.json['Work Experience (Describe your experience)'] }}\nProjects: {{ $('Google Sheets Trigger').item.json['Projects'] }}\nEducation: {{ $('Google Sheets Trigger').item.json['Education (Degree)'] }}\n\nScore each criteria and respond in ONLY this exact format, nothing else:\n\nskills_score: <0-40>\nexperience_score: <0-30>\nprojects_score: <0-20>\neducation_score: <0-10>\ntotal_score: <0-100>\ndecision: <Strong/Average/Weak>\nreason: <one sentence explanation>"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        560,
        0
      ],
      "id": "65cbcbdd-3572-409b-9b41-2eea16c158d9",
      "name": "Gemini Scorer",
      "credentials": {
        "googlePalmApi": {
          "id": "j5fq4zhur0q1QhNI",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const extractorText = $('Gemini Extractor').item.json.content.parts[0].text;\nconst scorerText = $('Gemini Scorer').item.json.content.parts[0].text;\n\n// Parse extractor JSON output\nlet extracted = {};\ntry {\n  const clean = extractorText.replace(/```json|```/g, '').trim();\n  extracted = JSON.parse(clean);\n} catch(e) {\n  extracted = {\n    name: $('Google Sheets Trigger').item.json['Full Name'],\n    email: $('Google Sheets Trigger').item.json['Email Address'],\n    job_role: $('Google Sheets Trigger').item.json['Job Applying for (Python Developer or Data Analyst)'],\n    skills: $('Google Sheets Trigger').item.json['Your skills (eg: Python, SQL, Power BI)'],\n    years_of_experience: 'unknown',\n    projects: $('Google Sheets Trigger').item.json['Projects'],\n    education: $('Google Sheets Trigger').item.json['Education (Degree)']\n  };\n}\n\n// Parse scorer output\nconst lines = scorerText.split('\\n');\nconst getValue = (key) => {\n  const line = lines.find(l => l.startsWith(key));\n  return line ? line.split(':')[1].trim() : '0';\n};\n\nconst skillsScore = getValue('skills_score');\nconst experienceScore = getValue('experience_score');\nconst projectsScore = getValue('projects_score');\nconst educationScore = getValue('education_score');\nconst totalScore = getValue('total_score');\nconst decision = getValue('decision');\nconst reason = getValue('reason');\n\nreturn {\n  json: {\n    name: extracted.name,\n    email: extracted.email,\n    job_role: extracted.job_role,\n    skills: Array.isArray(extracted.skills) ? extracted.skills.join(', ') : extracted.skills,\n    years_of_experience: extracted.years_of_experience,\n    experience_description: extracted.experience_description,\n    projects: extracted.projects,\n    education: extracted.education,\n    skills_score: skillsScore,\n    experience_score: experienceScore,\n    projects_score: projectsScore,\n    education_score: educationScore,\n    total_score: totalScore,\n    decision: decision,\n    reason: reason,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
