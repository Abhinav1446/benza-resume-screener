        "messages": {
          "values": [
            {
              "content": "=You are a resume parser. Extract the following information from the resume details below and respond in ONLY this exact JSON format, nothing else:\n\n{\n  \"name\": \"candidate name\",\n  \"email\": \"candidate email\",\n  \"job_role\": \"job role applying for\",\n  \"skills\": [\"skill1\", \"skill2\"],\n  \"years_of_experience\": \"number or fresher\",\n  \"experience_description\": \"brief summary of experience\",\n  \"projects\": \"brief summary of projects\",\n  \"education\": \"degree and institution\"\n}\n\nCandidate Details:\nName: {{ $json['Full Name'] }}\nEmail: {{ $json['Email Address'] }}\nJob Role: {{ $json['Job Applying for (Python Developer or Data Analyst)'] }}\nSkills: {{ $json['Your skills (eg: Python, SQL, Power BI)'] }}\nExperience: {{ $json['Work Experience (Describe your experience)'] }}\nProjects: {{ $json['Projects'] }}\nEducation: {{ $json['Education (Degree)'] }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "id": "6e4b3d89-dfeb-4a51-84b7-c63b5ec4b7a2",
      "name": "Gemini Extractor",
      "credentials": {
        "googlePalmApi": {
          "id": "j5fq4zhur0q1QhNI",
